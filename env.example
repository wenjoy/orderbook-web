# 后端 API 前缀（vite 会代理 /api → http://127.0.0.1:8080）
VITE_API_URL=/api
# WebSocket 地址，留空则用当前页面的 host + /ws
VITE_WS_URL=
# Solana RPC
VITE_SOLANA_RPC=http://127.0.0.1:8899
# settlement program id
VITE_SETTLEMENT_PROGRAM_ID=Sett1eMent11111111111111111111111111111111
# 代币水龙头（开户引导第 3 步）。留空则该按钮置灰。
# 默认约定：POST 该地址，body = { owner, base_mint, quote_mint, base_amount, quote_amount }
VITE_FAUCET_URL=
