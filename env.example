# 后端地址（vite 开发代理 /api、/ws 的 target）
VITE_BACKEND_URL=http://127.0.0.1:8080
# 后端 API 前缀（vite 会代理 /api → VITE_BACKEND_URL）
VITE_API_URL=/api
# WebSocket 地址，留空则用当前页面的 host + /ws
VITE_WS_URL=
# Solana RPC（必填，不填会直接报错提示）
VITE_SOLANA_RPC=http://127.0.0.1:8899
# settlement program id
VITE_SETTLEMENT_PROGRAM_ID=Sett1eMent11111111111111111111111111111111
# 代币水龙头地址（开户引导第 3 步）。不填则默认走 ${VITE_API_URL}/onchain/request_token_airdrop。
# 契约：POST { "destination": 钱包地址, "amount": 最小单位 u64, "mint": mint }
# 前端一次点击内部会请求两次（base / quote）。
VITE_FAUCET_URL=
